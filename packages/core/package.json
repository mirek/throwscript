{
  "name": "@mirek/throwscript-core",
  "version": "0.4.0",
  "description": "Analyzer asserting every TypeScript function that can throw documents it with a JSDoc @throws tag.",
  "keywords": [
    "throwscript",
    "throws",
    "jsdoc",
    "typescript",
    "linter",
    "exceptions",
    "errors"
  ],
  "author": "Mirek Rusin (https://github.com/mirek)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "typescript": ">=5.5.0 <7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/throwscript.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/mirek/throwscript/tree/main/packages/core#readme",
  "bugs": "https://github.com/mirek/throwscript/issues"
}
